#!/usr/bin/env bash
# Convenience wrapper to update VS Code (stable/insiders) hash in applications/vscode.nix
# Delegates to extras/update-vscode-hash.sh
#
# Usage:
#   nix-vscode-update [stable|insiders|auto]
#   (Arguments are passed through; default is auto if omitted.)

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="$SCRIPT_DIR/update-vscode-hash.sh"
if [[ ! -x "$TARGET" ]]; then
  echo "[ERROR] Cannot find executable update script at $TARGET" >&2
  exit 1
fi
exec "$TARGET" "$@"
