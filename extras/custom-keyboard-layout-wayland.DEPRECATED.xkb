// XKB configuration for Swedish Dvorak (svdvorak) with Ctrl overlay to Swedish QWERTY
// This version uses ISO_Level5 modifier approach which works better in Wayland
xkb_keymap {
    xkb_keycodes  { include "evdev" };
    
    xkb_types     { 
        include "complete"
        
        // Define a new type that has 5 levels: normal, shift, altgr, shift+altgr, and ctrl
        type "CTRL_OVERLAY" {
            modifiers = Shift+LevelThree+Control;
            map[None] = Level1;
            map[Shift] = Level2;
            map[LevelThree] = Level3;
            map[Shift+LevelThree] = Level4;
            map[Control] = Level5;
            map[Shift+Control] = Level5;
            map[LevelThree+Control] = Level5;
            map[Shift+LevelThree+Control] = Level5;
            level_name[Level1] = "Base";
            level_name[Level2] = "Shift";
            level_name[Level3] = "AltGr";
            level_name[Level4] = "Shift+AltGr";
            level_name[Level5] = "Ctrl";
        };
    };
    
    xkb_compat    { include "complete" };
    
    xkb_symbols   {
        // Start with basic PC keyboard
        include "pc+inet(evdev)"
        
        name[Group1]= "Swedish (Dvorak with Ctrl QWERTY overlay)";
        
        // Set Right Alt as Level3 (AltGr)
        include "level3(ralt_switch)"
        
        // Define Control keys normally
        key <LCTL> { [ Control_L ] };
        key <RCTL> { [ Control_R ] };
        
        // Swedish Dvorak layout with Ctrl overlay to Swedish QWERTY positions
        // Format: [ Dvorak, Dvorak+Shift, Dvorak+AltGr, Dvorak+Shift+AltGr, QWERTY_with_Ctrl ]
        
        // Number row
        key <TLDE> { type="CTRL_OVERLAY", [ section, onehalf, paragraph, threequarters, section ] };
        key <AE01> { type="CTRL_OVERLAY", [ 1, exclam, exclamdown, onesuperior, 1 ] };
        key <AE02> { type="CTRL_OVERLAY", [ 2, quotedbl, at, twosuperior, 2 ] };
        key <AE03> { type="CTRL_OVERLAY", [ 3, numbersign, sterling, threesuperior, 3 ] };
        key <AE04> { type="CTRL_OVERLAY", [ 4, currency, dollar, onequarter, 4 ] };
        key <AE05> { type="CTRL_OVERLAY", [ 5, percent, EuroSign, NoSymbol, 5 ] };
        key <AE06> { type="CTRL_OVERLAY", [ 6, ampersand, yen, NoSymbol, 6 ] };
        key <AE07> { type="CTRL_OVERLAY", [ 7, slash, braceleft, division, 7 ] };
        key <AE08> { type="CTRL_OVERLAY", [ 8, parenleft, bracketleft, guillemotleft, 8 ] };
        key <AE09> { type="CTRL_OVERLAY", [ 9, parenright, bracketright, guillemotright, 9 ] };
        key <AE10> { type="CTRL_OVERLAY", [ 0, equal, braceright, degree, 0 ] };
        key <AE11> { type="CTRL_OVERLAY", [ plus, question, backslash, questiondown, plus ] };
        key <AE12> { type="CTRL_OVERLAY", [ dead_acute, dead_grave, dead_cedilla, dead_ogonek, dead_acute ] };
        
        // Top row (QWERTY: Q W E R T Y U I O P)
        key <AD01> { type="CTRL_OVERLAY", [ odiaeresis, Odiaeresis, oslash, Oslash, q ] };
        key <AD02> { type="CTRL_OVERLAY", [ aring, Aring, dead_diaeresis, dead_abovering, w ] };
        key <AD03> { type="CTRL_OVERLAY", [ adiaeresis, Adiaeresis, ae, AE, e ] };
        key <AD04> { type="CTRL_OVERLAY", [ p, P, thorn, THORN, r ] };
        key <AD05> { type="CTRL_OVERLAY", [ y, Y, yen, NoSymbol, t ] };
        key <AD06> { type="CTRL_OVERLAY", [ f, F, ordfeminine, NoSymbol, y ] };
        key <AD07> { type="CTRL_OVERLAY", [ g, G, eng, ENG, u ] };
        key <AD08> { type="CTRL_OVERLAY", [ c, C, copyright, NoSymbol, i ] };
        key <AD09> { type="CTRL_OVERLAY", [ r, R, registered, NoSymbol, o ] };
        key <AD10> { type="CTRL_OVERLAY", [ l, L, lstroke, Lstroke, p ] };
        key <AD11> { type="CTRL_OVERLAY", [ comma, semicolon, dead_cedilla, dead_ogonek, aring ] };
        key <AD12> { type="CTRL_OVERLAY", [ dead_diaeresis, dead_circumflex, dead_tilde, dead_caron, dead_diaeresis ] };
        
        // Home row (QWERTY: A S D F G H J K L)
        key <AC01> { type="CTRL_OVERLAY", [ a, A, schwa, SCHWA, a ] };
        key <AC02> { type="CTRL_OVERLAY", [ o, O, oe, OE, s ] };
        key <AC03> { type="CTRL_OVERLAY", [ e, E, eacute, Eacute, d ] };
        key <AC04> { type="CTRL_OVERLAY", [ u, U, downarrow, uparrow, f ] };
        key <AC05> { type="CTRL_OVERLAY", [ i, I, rightarrow, idotless, g ] };
        key <AC06> { type="CTRL_OVERLAY", [ d, D, eth, ETH, h ] };
        key <AC07> { type="CTRL_OVERLAY", [ h, H, hstroke, Hstroke, j ] };
        key <AC08> { type="CTRL_OVERLAY", [ t, T, tslash, Tslash, k ] };
        key <AC09> { type="CTRL_OVERLAY", [ n, N, eng, ENG, l ] };
        key <AC10> { type="CTRL_OVERLAY", [ s, S, ssharp, NoSymbol, odiaeresis ] };
        key <AC11> { type="CTRL_OVERLAY", [ minus, underscore, hyphen, dead_macron, adiaeresis ] };
        
        // Bottom row (QWERTY: Z X C V B N M)
        key <AB01> { type="CTRL_OVERLAY", [ period, colon, periodcentered, dead_abovedot, z ] };
        key <AB02> { type="CTRL_OVERLAY", [ q, Q, Greek_OMEGA, NoSymbol, x ] };
        key <AB03> { type="CTRL_OVERLAY", [ j, J, NoSymbol, NoSymbol, c ] };
        key <AB04> { type="CTRL_OVERLAY", [ k, K, kra, NoSymbol, v ] };
        key <AB05> { type="CTRL_OVERLAY", [ x, X, multiply, NoSymbol, b ] };
        key <AB06> { type="CTRL_OVERLAY", [ b, B, leftarrow, NoSymbol, n ] };
        key <AB07> { type="CTRL_OVERLAY", [ m, M, mu, NoSymbol, m ] };
        key <AB08> { type="CTRL_OVERLAY", [ w, W, NoSymbol, NoSymbol, comma ] };
        key <AB09> { type="CTRL_OVERLAY", [ v, V, NoSymbol, NoSymbol, period ] };
        key <AB10> { type="CTRL_OVERLAY", [ z, Z, NoSymbol, NoSymbol, minus ] };
        
        // Special keys
        key <BKSL> { type="CTRL_OVERLAY", [ apostrophe, asterisk, acute, multiply, apostrophe ] };
        key <LSGT> { type="CTRL_OVERLAY", [ less, greater, bar, brokenbar, less ] };
        key <SPCE> { type="CTRL_OVERLAY", [ space, space, space, nobreakspace, space ] };
    };
    
    xkb_geometry  { include "pc(pc105)" };
};
